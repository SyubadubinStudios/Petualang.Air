<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Browser-hosted build of the same UI and domain code; packaged with Electron for Linux and macOS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <!-- Linked components and services keep their PetualangAir.Wpf.* namespaces. -->
    <RootNamespace>PetualangAir.Wpf</RootNamespace>
    <AssemblyName>PetualangAir.Web</AssemblyName>
    <CompressionEnabled>false</CompressionEnabled>
    <SharedRoot>../PetualangAir.Wpf/</SharedRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SharedRoot)Services/**/*.cs" Link="Services/%(RecursiveDir)%(Filename)%(Extension)" />
    <RazorComponent Include="$(SharedRoot)Components/**/*.razor" Link="Components/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The engine, styles, models, audio, and vendored Three.js are shared with the WPF host rather than duplicated. -->
  <Target Name="CopySharedGameAssets" AfterTargets="Publish">
    <ItemGroup>
      <SharedGameAsset Include="$(SharedRoot)wwwroot/**/*" Exclude="$(SharedRoot)wwwroot/index.html;$(SharedRoot)wwwroot/models/*.blend*" />
    </ItemGroup>
    <Copy SourceFiles="@(SharedGameAsset)" DestinationFiles="@(SharedGameAsset->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
