{
  "name": "petualang-air-desktop",
  "productName": "Petualang Air",
  "version": "1.0.0",
  "description": "Ekspedisi Bang Jopi di Perairan Nusantara",
  "author": "Ariana Mischa Fadhila (Syubadubin Studios)",
  "homepage": "https://github.com/SyubadubinStudios/Petualang.Air",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:web": "dotnet publish ../PetualangAir.Web/PetualangAir.Web.csproj -c Release -o build/web",
    "start": "electron .",
    "smoke": "node smoke.mjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "studio.syubadubin.petualangair",
    "productName": "Petualang Air",
    "copyright": "2026 Syubadubin Studios",
    "directories": { "output": "../artifacts/desktop" },
    "files": ["main.cjs", "preload.cjs", "build/web/wwwroot/**"],
    "extraResources": [
      { "from": "../LICENSE", "to": "LICENSE.txt" },
      { "from": "../THIRD-PARTY-NOTICES.md", "to": "THIRD-PARTY-NOTICES.md" }
    ],
    "artifactName": "PetualangAir-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Game",
      "executableName": "petualang-air"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.adventure-games"
    }
  }
}
